{
  "id": "inventory_panel",
  "display_name": "Inventory",
  "skin": "inventory_panel",
  "anchor": "center",
  "modal": true,
  "size": { "width": 480, "height": 270 },
  "layout": "free",
  "elements": [
    { "id": "title", "type": "label", "text": "Inventory", "x": 16, "y": 10 },
    { "id": "use_button", "type": "button", "text": "Use", "action": "inventory-use", "x": 16, "y": 28, "width": 90, "height": 16 },
    { "id": "drop_button", "type": "button", "text": "Drop", "action": "inventory-drop", "x": 112, "y": 28, "width": 90, "height": 16 },
    { "id": "hint", "type": "label", "text": "[I] / [Backspace] close", "x": 300, "y": 12 },
    {
      "id": "output",
      "type": "scrollable-text",
      "x": 16,
      "y": 50,
      "width": 448,
      "height": 188,
      "fontSize": "9px",
      "color": "#d8e8ff",
      "text": ""
    },
    { "id": "close_button", "type": "button", "text": "Close", "action": "close-window", "x": 16, "y": 246, "width": 90, "height": 16 }
  ]
}
