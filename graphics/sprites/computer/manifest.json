{
  "id": "computer",
  "display_name": "Computer",
  "type": "prop",
  "frame_size": { "width": 32, "height": 32 },
  "pivot": { "x": 0.5, "y": 0.75 },
  "directionality": {
    "mode": "8-dir",
    "directions": [
      "south", "south-east", "east", "north-east",
      "north", "north-west", "west", "south-west"
    ]
  },
  "states": {
    "idle": {
      "type": "static-per-direction",
      "frame_rate": 1,
      "loop": true,
      "source": "rotations/{direction}.png"
    }
  },
  "hitbox": { "width": 24, "height": 8 },
  "scale": 1
}
